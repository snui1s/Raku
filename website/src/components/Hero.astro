---
import Download from "./Download.astro";
import type { ReleaseInfo } from "../lib/release";

interface Props { release: ReleaseInfo }
const { release } = Astro.props;
---
<section id="hero" class="hero">
  <!-- Still image first: always visible, and the fallback when the live scene is not used -->
  {(["light", "dark"] as const).map((t) => (
    <picture class={`still still-${t}`} data-hero-still>
      <source media="(max-width: 960px)" srcset={`/hero/${t}-sm.avif`} type="image/avif" />
      <source media="(max-width: 960px)" srcset={`/hero/${t}-sm.webp`} type="image/webp" />
      <source srcset={`/hero/${t}.avif`} type="image/avif" />
      <source srcset={`/hero/${t}.webp`} type="image/webp" />
      <img src={`/hero/${t}.webp`} alt="" width="1920" height="1200" fetchpriority="high" decoding="async" />
    </picture>
  ))}
  <div id="hero-scene" class="scene" aria-hidden="true"></div>

  <div class="copy">
    <p class="eyebrow">Notes for Windows</p>
    <h1>Raku<span>楽</span></h1>
    <p class="tag">A fast, distraction-free note-taking app. No accounts. No cloud. Just write.</p>
    <div class="cta">
      <Download release={release} />
      <a class="ghost" href="/docs/getting-started/">Read the docs</a>
    </div>
    <p class="meta">
      {release.version ? `v${release.version} · ` : ""}About 4.6 MB · Free and open source
    </p>
    <p class="smartscreen">
      Windows may warn about an unsigned app. Click <strong>More info</strong>, then <strong>Run anyway</strong>.{" "}
      <a href="/docs/getting-started/#windows-smartscreen">Why?</a>
    </p>
  </div>
</section>

<style>
  .hero { position: relative; min-height: min(100vh, 960px); overflow: hidden; }
  .still, .scene { position: absolute; inset: 0; width: 100%; height: 100%; }
  .still img { width: 100%; height: 100%; object-fit: cover; object-position: 70% bottom; display: block; }
  .still-dark { display: none; }
  :global(html[data-theme="dark"]) .still-light { display: none; }
  :global(html[data-theme="dark"]) .still-dark { display: block; }
  .copy {
    position: relative; z-index: 10; max-width: 560px;
    min-height: min(100vh, 960px); padding: 80px max(24px, 3vw) 0; margin-left: max(0px, 5vw);
    display: flex; flex-direction: column; justify-content: center;
  }
  .eyebrow { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0 0 18px; }
  h1 { margin: 0; font-size: clamp(72px, 11vw, 132px); line-height: 0.95; letter-spacing: -0.03em; font-weight: 800; }
  h1 span { color: var(--accent); font-weight: 400; margin-left: 0.12em; font-size: 0.62em; }
  .tag { margin: 22px 0 0; font-size: 19px; line-height: 1.55; color: var(--muted); max-width: 420px; }
  .cta { margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .ghost {
    padding: 13px 22px; border-radius: 12px; font-size: 15px; font-weight: 600;
    color: var(--text); text-decoration: none; border: 1px solid var(--border);
  }
  .ghost:hover { background: var(--border); }
  .meta { margin: 14px 0 0; font-size: 13px; color: var(--muted); }
  .smartscreen { margin: 8px 0 0; font-size: 13px; color: var(--muted); max-width: 440px; line-height: 1.5; }
  .smartscreen a { color: var(--text); }
  @media (max-width: 767px) {
    .copy { justify-content: flex-start; padding-top: 22vh; margin-left: 0; }
  }
</style>

<script>
  import { detectEnv, shouldRunScene } from "../scene/capabilities";

  const host = document.getElementById("hero-scene");
  if (host && shouldRunScene(detectEnv(window))) {
    const getTheme = () => (document.documentElement.dataset.theme === "dark" ? "dark" : "light") as "light" | "dark";
    // Three.js is a separate chunk, loaded only here, after the still has painted
    import("../scene/index")
      .then(({ mountScene }) => mountScene(host, { getTheme }))
      .then((handle) => {
        // Reduced motion switched on while the page is open: drop the live scene, the still stays
        window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", (e) => {
          if (e.matches) handle.dispose();
        });
      })
      .catch(() => {});
  }
</script>
