---
<section class="wrap">
  <img class="shot shot-light" src="/screenshots/light.png" alt="Raku in light mode, with a note open and the folder sidebar on the left" width="1600" loading="lazy" />
  <img class="shot shot-dark" src="/screenshots/dark.png" alt="Raku in dark mode, with a note open and the folder sidebar on the left" width="1600" loading="lazy" />
</section>

<style>
  .wrap { max-width: 1080px; margin: 0 auto; padding: 72px max(24px, 3vw) 24px; }
  .shot { width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--border); box-shadow: 0 24px 60px -30px rgba(0,0,0,0.35); }
  .shot-dark { display: none; }
  :global(html[data-theme="dark"]) .shot-light { display: none; }
  :global(html[data-theme="dark"]) .shot-dark { display: block; }
</style>
