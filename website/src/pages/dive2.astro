---
// PROTOTYPE (spike): hero -> the camera tilts up into the night sky -> the features appear as a constellation.
// Lives on its own page so the real home page and the first dive prototype are untouched.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Download from "../components/Download.astro";
import { loadRelease } from "../lib/release";
import { constellationHeightVh } from "../scene/constellation";

const release = loadRelease();
const features = [
  ["Local first", "Notes, folders and images stay on your computer. No account, no cloud."],
  ["Small and fast", "A 5 MB installer. The window appears in under a tenth of a second."],
  ["Rich text", "Headings, lists, checklists, quotes, highlights, fonts and colors."],
  ["Make it yours", "Light and dark, 8 color palettes, and a page that zooms with Ctrl and scroll."],
  ["Clean writing space", "One calm page, just your words. Zen mode and a Pomodoro timer when you need to focus."],
];
const minor = ["Folders", "Quick search", "Export and backup", "Auto-update"];
---
<Base title="Raku (constellation prototype)" description="Prototype of the hero-to-features scroll.">
  <meta name="robots" content="noindex" slot="head" />
  <Nav />
  <main>
    <section id="stage" class="stage" style={`--stage-vh: ${constellationHeightVh()};`}>
      <div class="frame">
        <picture class="still" data-hero-still>
          <source media="(max-width: 960px)" srcset="/hero/dark-sm.avif" type="image/avif" />
          <source media="(max-width: 960px)" srcset="/hero/dark-sm.webp" type="image/webp" />
          <source srcset="/hero/dark.avif" type="image/avif" />
          <source srcset="/hero/dark.webp" type="image/webp" />
          <img src="/hero/dark.webp" alt="" width="1920" height="1200" decoding="async" />
        </picture>
        <div id="stage-scene" class="scene" aria-hidden="true"></div>

        <div class="copy">
          <p class="eyebrow">Notes for Windows</p>
          <h1>Raku <span>楽</span></h1>
          <p class="tag">A fast, distraction-free note-taking app. No accounts. No cloud. Just write.</p>
          <div class="cta">
            <Download release={release} />
            <a class="ghost" href="/docs/getting-started/">Read the docs</a>
          </div>
        </div>
        <p class="hint" aria-hidden="true"><span>Scroll</span><i></i></p>

        <div class="sky">
          <h2 class="sky-title">What Raku does</h2>
          <ol class="labels">
            {features.map(([title, text], i) => (
              <li data-index={i}>
                <button type="button" class="label" aria-label={`${title}: ${text}`}>
                  <span class="num">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{title}</h3>
                  <p>{text}</p>
                </button>
              </li>
            ))}
          </ol>
          <p class="minor">{minor.join("   ·   ")}</p>
          <div class="dots" aria-hidden="true">
            {features.map(() => <i></i>)}
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer><span>Raku, MIT licensed. Prototype page.</span></footer>
</Base>

<style>
  .stage { position: relative; }
  .frame { position: relative; min-height: 100vh; overflow: hidden; background: #07070b; }
  .still, .scene { position: absolute; inset: 0; width: 100%; height: 100%; }
  .still img { width: 100%; height: 100%; object-fit: cover; object-position: 70% bottom; display: block; }

  /* hero text, same look as the home page */
  .copy {
    position: relative; z-index: 10; max-width: min(560px, 47vw);
    min-height: 100vh; padding: 80px max(24px, 3vw) 0; margin-left: max(0px, 5vw);
    display: flex; flex-direction: column; justify-content: center;
    opacity: calc(1 - var(--hero-out, 0)); transform: translateY(calc(var(--hero-out, 0) * -36px));
    pointer-events: var(--copy-events, auto);
  }
  .eyebrow { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #c9d4ec; margin: 0 0 18px; }
  h1 { margin: 0; font-size: clamp(72px, 11vw, 132px); line-height: 0.95; letter-spacing: -0.03em; font-weight: 800; }
  h1 span { color: var(--accent); font-weight: 400; margin-left: 0.12em; font-size: 0.62em; }
  .tag { margin: 22px 0 0; font-size: 19px; line-height: 1.55; color: #c9d4ec; max-width: 420px; }
  .cta { margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .ghost { padding: 13px 22px; border-radius: 12px; font-size: 15px; font-weight: 600; color: var(--text); text-decoration: none; border: 1px solid var(--border); }

  .hint { display: none; }

  /* the sky: labels for the feature stars (the page moves them next to the stars every frame) */
  .sky { position: relative; z-index: 10; padding: 64px max(24px, 3vw); background: #07070b; }
  .sky-title { margin: 0 0 22px; font-size: 14px; letter-spacing: 0.3em; text-transform: uppercase; color: #ffe9a8; }
  .labels { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .label { all: unset; display: block; box-sizing: border-box; width: 100%; cursor: pointer; } /* buttons shrink-wrap unless given a width */
  .num { display: block; font-size: 12px; letter-spacing: 0.2em; color: #ffe9a8; }
  .label h3 { margin: 4px 0 0; font-size: 22px; color: #fff3d6; }
  .label p { margin: 6px 0 0; color: #c9d4ec; font-size: 15px; line-height: 1.5; max-width: 40ch; }
  .minor { margin: 28px 0 0; color: var(--muted); font-size: 13px; letter-spacing: 0.04em; }
  .dots { display: none; }
  footer { padding: 24px max(24px, 3vw); border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; }

  /* live: the stage is tall, the frame is pinned, and the camera and labels are driven by scroll */
  .stage.live { height: calc(var(--stage-vh) * 100vh); }
  .stage.live .frame { position: sticky; top: 0; height: 100vh; min-height: 0; }
  .stage.live .sky { position: absolute; inset: 0; padding: 0; background: none; opacity: var(--ui, 0); pointer-events: none; }
  .stage.live .sky-title { position: absolute; left: max(24px, 3vw); top: 84px; margin: 0; }
  .stage.live .labels { display: block; }
  .stage.live .labels li { position: absolute; left: 0; top: 0; width: 280px; will-change: transform, opacity; opacity: 0; }
  .stage.live .label { pointer-events: auto; }
  .stage.live .label { position: relative; padding-left: 38px; opacity: 0.4; transition: opacity 0.4s ease; }
  /* a short line from the star to its label */
  .stage.live .label::before { content: ""; position: absolute; left: 0; top: 14px; width: 28px; height: 1px; background: linear-gradient(90deg, rgba(255, 233, 168, 0), rgba(255, 233, 168, 0.9)); transform: scaleX(-1); }
  .stage.live li.left .label { padding-left: 0; padding-right: 38px; text-align: right; }
  .stage.live li.left .label::before { left: auto; right: 0; transform: none; }
  .stage.live li.active .label { opacity: 1; }
  .stage.live .label p { position: absolute; left: 38px; right: 0; top: 100%; opacity: 0; transform: translateY(-4px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .stage.live li.left .label p { left: 0; right: 38px; }
  .stage.live li.active .label p { opacity: 1; transform: none; }
  .stage.live .minor { position: absolute; left: max(24px, 3vw); bottom: 7vh; margin: 0; opacity: var(--minor, 0); }
  .stage.live .dots { display: flex; gap: 10px; position: absolute; right: max(24px, 3vw); top: 50%; transform: translateY(-50%); flex-direction: column; }
  .stage.live .dots i { width: 6px; height: 6px; border-radius: 50%; background: rgba(255, 233, 168, 0.3); transition: background 0.3s ease, transform 0.3s ease; }
  .stage.live .dots i.on { background: #ffe9a8; transform: scale(1.5); }
  .stage.live .hint {
    display: block; position: absolute; left: 50%; bottom: 4vh; z-index: 10; transform: translateX(-50%); margin: 0;
    font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #d9d4e4; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8); text-align: center;
    opacity: calc(1 - var(--hero-out, 0) * 3);
  }
  .stage.live .hint i { display: block; width: 1px; height: 28px; margin: 8px auto 0; background: linear-gradient(#d9d4e4, transparent); animation: hint 2s ease-in-out infinite; }
  @keyframes hint { 0%, 100% { transform: scaleY(0.4); transform-origin: top; } 50% { transform: scaleY(1); transform-origin: top; } }

  /* no live scene (phones, reduced motion, no WebGL): the picture, then a plain list */
  @media (max-width: 767px) {
    .copy { max-width: none; min-height: 0; padding-top: 96px; padding-bottom: 12px; margin-left: 0; justify-content: flex-start; }
    .still { position: relative; inset: auto; height: auto; aspect-ratio: 1 / 1; }
    .scene { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .stage.live .hint i { animation: none; } }
</style>

<script>
  import { detectEnv, shouldRunScene } from "../scene/capabilities";
  import { CONSTELLATION, constellationTimeline } from "../scene/constellation";

  const stage = document.getElementById("stage");
  const host = document.getElementById("stage-scene");
  if (stage && host && shouldRunScene(detectEnv(window))) {
    stage.classList.add("live");
    const items = [...stage.querySelectorAll<HTMLLIElement>(".labels li")];
    const dots = [...stage.querySelectorAll<HTMLElement>(".dots i")];
    const N = CONSTELLATION.stars.length;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const smoothstep = (a: number, b: number, v: number) => { const t = clamp((v - a) / (b - a)); return t * t * (3 - 2 * t); };

    // The scroll position the page is at, and the (slightly behind) position the scene follows. Following it with
    // a time-based easing makes mouse-wheel steps glide instead of jumping.
    let targetVh = 0, shownVh = 0, lastMs = 0;
    const readScroll = () => { targetVh = -stage.getBoundingClientRect().top / window.innerHeight; };
    addEventListener("scroll", readScroll, { passive: true });
    addEventListener("resize", readScroll);
    readScroll();
    shownVh = targetVh;

    let state = constellationTimeline(shownVh);
    const getState = () => {
      const now = performance.now();
      if (now - lastMs > 3) { // once per frame, however many times the scene asks
        const dt = lastMs ? Math.min(0.1, (now - lastMs) / 1000) : 0;
        lastMs = now;
        shownVh += (targetVh - shownVh) * (1 - Math.exp(-dt * 6));
        state = constellationTimeline(shownVh);
      }
      return state;
    };

    const current = (feature: number) => clamp(Math.floor(feature), 0, N - 1);
    const onProject = (pts: { x: number; y: number; visible: boolean }[]) => {
      const s = state, st = stage.style, width = host.clientWidth;
      st.setProperty("--hero-out", String(clamp(s.tilt * 2.2)));
      st.setProperty("--copy-events", s.tilt > 0.25 ? "none" : "auto"); // the faded-out buttons must not catch clicks
      st.setProperty("--ui", String(smoothstep(0.7, 1, s.tilt)));
      st.setProperty("--minor", String(clamp(s.feature - (N - 1))));
      const active = current(s.feature);
      items.forEach((li, i) => {
        const p = pts[i];
        const left = p.x + 14 + 280 > width - 16; // the label goes on the left of its star only if it would run off the right edge
        li.classList.toggle("left", left);
        li.classList.toggle("active", i === active && s.feature > 0);
        const w = 280, x = left ? p.x - w - 14 : p.x + 14;
        li.style.transform = "translate3d(" + x.toFixed(1) + "px," + (p.y - 15).toFixed(1) + "px,0)";
        li.style.opacity = p.visible && i <= active + 1 ? "1" : "0"; // only the current star and the next one show a label
      });
      dots.forEach((d, i) => d.classList.toggle("on", i === active && s.feature > 0));
    };

    // clicking a label scrolls to that feature
    items.forEach((li, i) => li.querySelector("button")?.addEventListener("click", () => {
      const vh = CONSTELLATION.holdVh + CONSTELLATION.tiltVh + CONSTELLATION.itemVh * (i + 0.5);
      scrollTo({ top: stage.getBoundingClientRect().top + scrollY + vh * window.innerHeight, behavior: "smooth" });
    }));

    import("../scene/index")
      .then(({ mountScene }) => mountScene(host, { constellation: { getState, onProject }, onFail: () => stage.classList.remove("live") }))
      .catch((err) => {
        console.warn("The live scene could not start; showing the still image instead.", err);
        stage.classList.remove("live");
      });
  }
</script>
