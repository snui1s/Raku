<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: sign the NSIS installer produced by the release workflow.
     The workflow uploads the installer as a zip artifact; SignPath signs the .exe inside it. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Raku_*_x64-setup.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
